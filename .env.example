NEXT_PUBLIC_DEFAULT_CURRENCY="INR"

# ---- SMTP (email) ----
# Gmail:  host smtp.gmail.com, port 587, user = your gmail, pass = 16-char App Password
#         (Google Account > Security > 2-Step Verification > App passwords)
# Brevo / SendGrid / Zoho / Outlook also work: use the host + port they give you.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"          # "true" only for port 465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
MAIL_FROM="Atelier Vera <your-email@gmail.com>"
STUDIO_INBOX_EMAIL="studio@yourdomain.com"   # where new enquiries are delivered

# ---- Middleware ----
ALLOWED_ORIGINS="http://localhost:3000"      # comma-separated, add your live domain
RATE_LIMIT_PER_MINUTE="60"
RATE_LIMIT_INQUIRIES="5"                     # enquiries per IP per 10 minutes
MAIL_TEST_TOKEN=""                           # only needed to call /api/mail/test in production
